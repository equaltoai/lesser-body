{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://lesser.host/contracts/soul-five-body.schema.v2.json",
    "title": "Host soul five-body hosted genesis declaration v2",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "schemaVersion": {
            "type": "string",
            "const": "soul-five-body-schema.v2"
        },
        "guidanceVersion": {
            "type": "string",
            "const": "soul-five-body-guidance.v2"
        },
        "fiveBodies": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "identity": {
                    "$ref": "#/$defs/bodySection"
                },
                "philosophy": {
                    "$ref": "#/$defs/bodySection"
                },
                "discipline": {
                    "$ref": "#/$defs/bodySection"
                },
                "boundaries": {
                    "$ref": "#/$defs/bodySection"
                },
                "soul": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "summary": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2400
                        },
                        "notes": {
                            "$ref": "#/$defs/notes"
                        },
                        "refusals": {
                            "type": "array",
                            "minItems": 3,
                            "maxItems": 8,
                            "items": {
                                "$ref": "#/$defs/refusal"
                            }
                        }
                    },
                    "required": [
                        "summary",
                        "notes",
                        "refusals"
                    ]
                }
            },
            "required": [
                "identity",
                "philosophy",
                "discipline",
                "boundaries",
                "soul"
            ]
        },
        "capabilities": {
            "type": "array",
            "minItems": 0,
            "maxItems": 25,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "capability": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                    },
                    "scope": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 480
                    },
                    "claimLevel": {
                        "type": "string",
                        "const": "self-declared"
                    },
                    "lastValidated": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "validationRef": {
                        "type": "string",
                        "maxLength": 256
                    },
                    "degradesTo": {
                        "type": "string",
                        "maxLength": 256
                    }
                },
                "required": [
                    "capability",
                    "scope",
                    "claimLevel",
                    "lastValidated",
                    "validationRef",
                    "degradesTo"
                ]
            }
        },
        "transparency": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "modelProviderUncertainty": {
                    "type": "string",
                    "maxLength": 1200
                },
                "operationalNotes": {
                    "type": "string",
                    "maxLength": 1200
                },
                "selfDeclaredNotice": {
                    "type": "string",
                    "maxLength": 480
                }
            },
            "required": [
                "modelProviderUncertainty",
                "operationalNotes",
                "selfDeclaredNotice"
            ]
        },
        "selfDescription": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "purpose": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 2400
                },
                "constraints": {
                    "type": "string",
                    "maxLength": 2400
                },
                "commitments": {
                    "type": "string",
                    "maxLength": 2400
                },
                "limitations": {
                    "type": "string",
                    "maxLength": 2400
                },
                "authoredBy": {
                    "type": "string",
                    "const": "agent"
                },
                "mintingModel": {
                    "type": "string",
                    "maxLength": 256
                }
            },
            "required": [
                "purpose",
                "constraints",
                "commitments",
                "limitations",
                "authoredBy",
                "mintingModel"
            ]
        },
        "boundaries": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                    },
                    "category": {
                        "type": "string",
                        "const": "refusal"
                    },
                    "statement": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1200
                    },
                    "rationale": {
                        "type": "string",
                        "maxLength": 1200
                    },
                    "addedAt": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "addedInVersion": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32
                    },
                    "signature": {
                        "type": "string",
                        "maxLength": 128
                    }
                },
                "required": [
                    "id",
                    "category",
                    "statement",
                    "rationale",
                    "addedAt",
                    "addedInVersion",
                    "signature"
                ]
            }
        },
        "adversarialReview": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "version": {
                    "type": "string",
                    "const": "hosted-genesis-adversarial-review.v1"
                },
                "reviewer": {
                    "type": "string",
                    "const": "hosted-genesis-deterministic-review.v1"
                },
                "result": {
                    "type": "string",
                    "const": "pass"
                },
                "findings": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "finding": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256
                            },
                            "refutation": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 480
                            },
                            "report": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 480
                            }
                        },
                        "required": [
                            "finding",
                            "refutation",
                            "report"
                        ]
                    }
                },
                "report": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                }
            },
            "required": [
                "version",
                "reviewer",
                "result",
                "findings",
                "report"
            ]
        }
    },
    "required": [
        "schemaVersion",
        "guidanceVersion",
        "fiveBodies",
        "capabilities",
        "transparency",
        "selfDescription",
        "boundaries",
        "adversarialReview"
    ],
    "$defs": {
        "bodySection": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2400
                },
                "notes": {
                    "$ref": "#/$defs/notes"
                }
            },
            "required": [
                "summary",
                "notes"
            ]
        },
        "notes": {
            "type": "array",
            "minItems": 0,
            "maxItems": 8,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 480
            }
        },
        "refusal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "bypass": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 480
                },
                "invariant": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 480
                },
                "closestSafePath": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 480
                }
            },
            "required": [
                "bypass",
                "invariant",
                "closestSafePath"
            ]
        }
    }
}
